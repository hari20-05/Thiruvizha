          "raw": "{\n  \"title\": \"Tech Meetup Updated\",\n  \"description\": \"Updated networking event information for the developer community.\",\n  \"category\": \"Workshop\",\n  \"city\": \"Boston\",\n  \"date\": \"2026-11-05\",\n  \"venue\": \"Innovation Hub\",\n  \"address\": \"100 Main Street, Boston, MA\",\n  \"latitude\": 42.3601,\n  \"longitude\": -71.0589,\n  \"image\": \"https://images.unsplash.com/photo-1511578314322-379afb476865?auto=format&fit=crop&w=1200&q=80\",\n  \"price\": 25,\n  \"organizer\": \"BuildTogether\"\n}"
