{
  "info": {
    "name": "Event Finder API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "API collection for the Community Event Finder app."
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/health",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "health"
          ]
        }
      }
    },
    {
      "name": "Get All Events",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
