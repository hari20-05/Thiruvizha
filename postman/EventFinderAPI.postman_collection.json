    {
      "name": "Get Completed Events",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/events?status=completed",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "events"],
          "query": [{"key": "status", "value": "completed"}]
        }
      }
    },
    {
      "name": "Get Events by City",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/events?city=New York",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "events"
          ],
          "query": [
            {
              "key": "city",
              "value": "New York"
            }
          ]
        }
      }
    },
    {
      "name": "Get Events by Category",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/events?category=Workshop",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
