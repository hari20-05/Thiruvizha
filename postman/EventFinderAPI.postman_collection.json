            "api",
            "events"
          ],
          "query": [
            {
              "key": "category",
              "value": "Workshop"
            }
          ]
        }
      }
    },
    {
      "name": "Search Events",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/events?search=music",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "events"
          ],
          "query": [
            {
              "key": "search",
              "value": "music"
            }
          ]
        }
      }
    },
    {
      "name": "Create Event",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Tech Meetup\",\n  \"description\": \"A community networking event for developers and startup founders.\",\n  \"category\": \"Workshop\",\n  \"city\": \"Boston\",\n  \"date\": \"2026-11-02\",\n  \"venue\": \"Innovation Hub\",\n  \"address\": \"100 Main Street, Boston, MA\",\n  \"latitude\": 42.3601,\n  \"longitude\": -71.0589,\n  \"image\": \"https://images.unsplash.com/photo-1511578314322-379afb476865?auto=format&fit=crop&w=1200&q=80\",\n  \"price\": 20,\n  \"organizer\": \"BuildTogether\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/events",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "events"
          ]
        }
      }
    },
